{
    "compilerOptions": {
        "target": "ES2017",
        "useDefineForClassFields": true,
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
    },
    "exclude": ["node_modules"]
}
