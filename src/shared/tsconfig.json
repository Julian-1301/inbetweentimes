{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist",
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["*.ts"],
    "exclude": ["node_modules", "dist"]
}